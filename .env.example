# ═════════════════════════════════════════════════════════════════════════════
# KaamSetu — Production & Development Environment Configuration
# Copy this file to .env.local for local development. NEVER commit real secrets.
# ═════════════════════════════════════════════════════════════════════════════

# ────────────────── 1. Application & Core Security ──────────────────
# Base URL of the application. Required for absolute link generation and push notifications.
# Dev default: http://localhost:3000 | Prod example: https://kaamsetu.org
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret key used for signing session cookies and HMAC OTP challenges.
# REQUIRED in production (minimum 32 characters).
# Generate via: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string-of-32+chars

# Runtime Mode:
# Set to "true" for zero-setup demo mode with in-memory seeded records (flagged isDemo: true).
# MUST be set to "false" in real production!
DEMO_MODE=true
NEXT_PUBLIC_DEMO_MODE=true

# Staging only override: allows DEMO_MODE=true under NODE_ENV=production. NEVER set in real production.
# ALLOW_DEMO_IN_PRODUCTION=false

# Optional: persist the demo store between server restarts (file path, git-ignored)
DEMO_STORE_FILE=.data/store.json


# ────────────────── 2. Production Database (PostgreSQL) ──────────────────
# Connection string for PostgreSQL database managed via Prisma.
# REQUIRED when DEMO_MODE=false.
# Run migrations using: npx prisma migrate deploy
DATABASE_URL=postgresql://user:password@localhost:5432/kaamsetu?schema=public


# ────────────────── 3. SMS & OTP Delivery Gateway ──────────────────
# Mode for OTP verification:
# Set to "true" only in development (returns the OTP code in API responses for testing).
# MUST be set to "false" in production!
OTP_DEV_MODE=true
OTP_TTL_SECONDS=300

# Selected SMS Provider: "console" | "fast2sms" | "msg91" | "twilio"
# Dev default: console (logs masked/plain codes) | Prod: fast2sms, msg91, or twilio
SMS_PROVIDER=console

# Fast2SMS Configuration (Indian DLT / Quick SMS)
FAST2SMS_API_KEY=

# MSG91 Configuration (Enterprise SMS Gateway)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=KMSETU

# Twilio Configuration (Global SMS Gateway)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=


# ────────────────── 4. File & Media Storage ──────────────────
# Storage Provider: "local" | "s3"
# Dev default: local (stores in STORAGE_LOCAL_DIR) | Prod: s3 (AWS S3, Cloudflare R2, MinIO)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=.data/uploads

# S3 / Cloudflare R2 / MinIO Compatible Storage (Required when STORAGE_PROVIDER=s3)
S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com
S3_BUCKET=kaamsetu-uploads
S3_REGION=ap-south-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=https://uploads.kaamsetu.org


# ────────────────── 5. Push Notifications ──────────────────
# Push Provider: "none" | "webpush" | "fcm"
# Dev default: none | Prod: webpush (W3C Web Push) or fcm (Firebase Cloud Messaging)
PUSH_PROVIDER=none

# Web Push VAPID Configuration (Required when PUSH_PROVIDER=webpush)
# Generate via: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@kaamsetu.org

# Firebase Cloud Messaging Service Account JSON string (Required when PUSH_PROVIDER=fcm)
FIREBASE_SERVICE_ACCOUNT_KEY=


# ────────────────── 6. Maps & Geocoding ──────────────────
# Maps Provider: "static" | "google" | "mapbox"
# Dev default: static (uses approximate district centroids with privacy preservation)
MAPS_PROVIDER=static

# Google Maps Platform API Key (Required when MAPS_PROVIDER=google)
GOOGLE_MAPS_API_KEY=

# Mapbox Access Token (Required when MAPS_PROVIDER=mapbox)
MAPBOX_ACCESS_TOKEN=


# ────────────────── 7. AI Assistant ──────────────────
# AI Provider: "rules" | "openai-compatible"
# "rules" operates offline deterministically with zero API keys in Hindi/English/Hinglish.
# "openai-compatible" connects to any standard OpenAI-compatible API endpoint (OpenAI, Groq, Ollama, vLLM).
AI_PROVIDER=rules
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini


# ────────────────── 8. Live Video Streaming ──────────────────
# Live Video Provider: "none" | "livekit" | "mux"
# Note: In-app chat and Q&A operate fully even when LIVE_PROVIDER=none.
# When "none", the room displays an explicit "Live stream not connected" status (never fake).
LIVE_PROVIDER=none

# LiveKit Configuration (WebRTC SFU)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_WS_URL=wss://live.kaamsetu.org

# Mux Video Configuration (Low-latency RTMP/HLS)
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
