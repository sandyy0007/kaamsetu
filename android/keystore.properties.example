# ═════════════════════════════════════════════════════════════════════════════
# Android Production Keystore Configuration Template
# Copy this file to "android/keystore.properties" and fill in your private values.
# NEVER commit "keystore.properties" or "*.jks" / "*.keystore" files to Git!
# ═════════════════════════════════════════════════════════════════════════════
#
# To generate a production release keystore, run:
#
#   keytool -genkeypair -v -keystore my-release-key.jks -keyalg RSA -keysize 2048 -validity 10000 -alias kaamsetu-key
#
# Then fill in the values below:

storeFile=../my-release-key.jks
storePassword=your-keystore-password
keyAlias=kaamsetu-key
keyPassword=your-key-password

